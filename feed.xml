    <entry>
        <title>Autumn</title>
        <author>
            <name>Jujube</name>
        </author>
        <link href="https://www.jujubemonster.com/autumn.html"/>
        <id>https://www.jujubemonster.com/autumn.html</id>
        <media:content url="https://www.jujubemonster.com/media/posts/116/itried-2.png" medium="image" />
            <category term="poetry"/>

        <updated>2026-07-24T15:20:03-07:00</updated>
            <summary type="html">
                <![CDATA[
                        <img src="https://www.jujubemonster.com/media/posts/116/itried-2.png" alt="" />
                    We are all falling. This hand here is falling. And look at the others: it is in them all. Yet there is One who holds this falling infinitely gently in His hands. -- Rainer Maria Rilke
                ]]>
            </summary>
        <content type="html">
            <![CDATA[
                    <p><img src="https://www.jujubemonster.com/media/posts/116/itried-2.png" class="type:primaryImage" alt="" /></p>
                <div class="" data-block="true" data-editor="4l8ln" data-offset-key="a0gqn-0-0">
<div class="public-DraftStyleDefault-block public-DraftStyleDefault-ltr" data-offset-key="a0gqn-0-0"><span data-offset-key="a0gqn-0-0">We are all falling. This hand here is falling.</span></div>
